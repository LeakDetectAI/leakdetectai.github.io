{
  "schemaVersion": 1,
  "checked": "2026-09-14",
  "purpose": "Source registry for deadline/ranking discovery and regex-based official-site checks.",
  "priorityOrder": [
    "official_venue_site",
    "official_submission_platform",
    "official_society_or_call_page",
    "trusted_deadline_aggregator",
    "ranking_metadata_source",
    "bibliographic_metadata_source"
  ],
  "discoveryFeeds": [
    {
      "name": "SecDeadlines",
      "use": "Security and privacy conference/workshop discovery",
      "url": "https://sec-deadlines.github.io/",
      "repository": "https://github.com/sec-deadlines/sec-deadlines.github.io",
      "regexHint": "sec-deadlines\\.github\\.io|github\\.com/sec-deadlines/sec-deadlines\\.github\\.io"
    },
    {
      "name": "AI Deadlines",
      "use": "Machine learning, AI, NLP, and vision deadline discovery",
      "url": "https://aideadlin.es/",
      "repository": "https://github.com/paperswithcode/ai-deadlines",
      "regexHint": "aideadlin\\.es|github\\.com/paperswithcode/ai-deadlines"
    },
    {
      "name": "WikiCFP",
      "use": "Broad CFP discovery only; verify against official pages before storing as official",
      "url": "http://www.wikicfp.com/cfp/",
      "regexHint": "wikicfp\\.com/cfp"
    },
    {
      "name": "OpenReview",
      "use": "Submission platform and venue metadata for ICLR, workshops, AISTATS, and many ML venues",
      "url": "https://openreview.net/",
      "regexHint": "openreview\\.net/(group|forum)\\?id="
